<div class="reports_card">

  <div class="reports_table_wrapper">
    <div class="reports_table_scroller">
      <table class="reports_table">
        <thead>
          <tr>
            <th>Sample ID</th>
            <th>Patient Name</th>
            <th>Sample Date</th>
            <th>Report Date</th>
            <th>NAD</th>
            <th>Report</th>
          </tr>
        </thead>
        <tbody>
              <tr>
                <td colspan="6" class="reports_empty">No Report Found</td>

              </tr>

        </tbody>
      </table>
    </div>
  </div>

  <div class="reports_footer">
    {% assign total_rows = section.blocks.size %}
    <p class="reports_range">
      {% if total_rows > 0 %}
        Showing 1 to {{ total_rows }} of {{ total_rows }} entries
      {% else %}
        Showing 0 entries
      {% endif %}
    </p>
    <div class="reports_pagination">
      <button type="button" disabled>«</button>
      <button type="button" disabled>‹</button>
      <span class="reports_page">1</span>
      <button type="button" disabled>›</button>
      <button type="button" disabled>»</button>
    </div>
  </div>
</div>

{% style %}
.reports_card {
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 0.75rem;
  padding: 0px;
  box-shadow: 0 4px 12px rgba(15, 23, 42, 0.04);
}

.reports_card__header {
  margin-bottom: 1rem;
}

.reports_title {
  font-size: 24px;
  font-weight: 600;
  color: #111827;
  margin: 0 0 0.25rem 0;
}

.reports_subtitle {
  margin: 0;
  color: #6b7280;
  font-size: 16px;
}

.reports_table_wrapper {
  border: 1px solid #f3f4f6;
  border-radius: 0.75rem;
  overflow: hidden;
}

.reports_table_scroller {
  width: 100%;
  overflow-x: auto;
}

.reports_table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  min-width: 720px;
}

.reports_table thead {
  background: #f9fafb;
}

.reports_table th {
    text-align: left;
    font-size: 16px;
    font-weight: 600;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid #e5e7eb;
}

.reports_table td {
  padding: 1rem;
  border-bottom: 1px solid #f3f4f6;
  font-size: 16px;
  color: #111827;
  vertical-align: middle;
}

.reports_table tbody tr:last-child td {
  border-bottom: none;
}

.reports_empty {
  text-align: center;
  color: #6b7280;
  font-size: 16px;
}

.sample_chip {
  font-weight: 600;
  color: #0f172a;
}

.patient_name {
  font-weight: 600;
  color: #111827;
}

.nad_badge {
  display: inline-flex;
  min-width: 3.25rem;
  justify-content: center;
  align-items: center;
  padding: 0.35rem 0.75rem;
  border-radius: 999px;
  font-size: 16px;
  font-weight: 600;
}

.badge-orange {
  background: rgba(251, 146, 60, 0.2);
  color: #c2410c;
}

.badge-purple {
  background: rgba(129, 140, 248, 0.18);
  color: #4338ca;
}

.badge-green {
  background: rgba(16, 185, 129, 0.2);
  color: #047857;
}

.reports_footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1rem;
  padding: 30px 20px;
}

.reports_range {
  margin: 0;
  color: #6b7280;
  font-size: 16px;
}

.reports_pagination {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
}

.reports_pagination button {
  border: 1px solid #e5e7eb;
  background: #fff;
  width: 32px;
  height: 32px;
  border-radius: 6px;
  font-weight: 600;
  color: #6b7280;
}

.reports_page {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: 6px;
  background: #7a5c43;
  color: #fff;
  font-weight: 600;
}

@media (max-width: 768px) {
  .reports_card {
    padding: 16px;
  }

  .reports_table {
    min-width: 100%;
  }
}
{% endstyle %}

